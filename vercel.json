{
  "version": 2,
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron.py",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/telegram",
      "destination": "/api/telegram.py"
    }
  ]
}
